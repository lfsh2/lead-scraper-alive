# Business Leads AI Automation v2.0 Configuration
# Copy this file to .env and update the values

# REQUIRED: OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Custom OpenAI Base URL (for Azure, OpenRouter, local LLM proxies, etc.)
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# INDUSTRY & CAMPAIGN SETTINGS (Set by setup wizard, or override here)
PRIMARY_INDUSTRY=professional
CAMPAIGN_STYLE=balanced

# OUTPUT LANGUAGE (indonesian / english)
OUTPUT_LANGUAGE=indonesian

# SCRAPING CONFIGURATION
DELAY_BETWEEN_SCRAPES=2000
MAX_RETRIES=3
DEFAULT_RESULT_LIMIT=20

# OUTPUT SETTINGS
OUTPUT_FORMAT=csv
OUTPUT_DIRECTORY=output

# ─── APIFY (reliable scraping + emails, scales to 1000/day) ───────────────
# One token runs every actor. Get it free at:
#   Apify Console → Settings → API & Integrations → Personal API token
# Leave blank to keep using the built-in Puppeteer scraper.
APIFY_TOKEN=

# How long to wait for a single actor run before giving up (seconds).
APIFY_MAX_WAIT_SECS=300

# Contact enrichment engine:
#   auto  = use Apify for Meta/Instagram sources when APIFY_TOKEN is set, else built-in
#   apify = always use Apify actors (Facebook Pages + Contact Details)
#   http  = always use the built-in cheerio enricher (free, lower hit rate)
ENRICH_PROVIDER=auto

# Actor IDs — override only if you want a different/updated actor.
# APIFY_ADS_ACTOR=curious_coder/facebook-ads-library-scraper
# APIFY_PAGES_ACTOR=apify/facebook-pages-scraper
# APIFY_CONTACT_ACTOR=vdrmota/contact-info-scraper
# APIFY_LEADS_FINDER_ACTOR=code_crafter/leads-finder
# APIFY_MAPS_ACTOR=compass/crawler-google-places
# APIFY_IG_ACTOR=apify/instagram-search-scraper
# Full JSON override for Leads Finder input (if its schema differs):
# APIFY_LEADS_FINDER_INPUT={"job_titles":["life coach"],"locations":["United States"],"max_results":500}

# Daily batch runner: hard cap on NEW leads recorded per run (safety valve).
DAILY_LEAD_CAP=1000

# LEAD INTELLIGENCE SETTINGS
MIN_LEAD_SCORE=60
ENABLE_LEAD_SCORING=true
PRIORITIZE_HIGH_RATING=true

# MARKETING AI SETTINGS
ENABLE_INDUSTRY_TEMPLATES=true
GENERATE_MULTI_TOUCH=false
MAX_CONTENT_GENERATION=50

# ADVANCED SETTINGS (Optional)
ENABLE_DEBUG_LOGGING=false
SAVE_PROGRESS_LOGS=true
AUTO_CLEANUP_OLD_CAMPAIGNS=false

# NOTE: Business profile (name, phone, email, service description, etc.)
# is configured in business-profile.json — run: npm run setup

# FUTURE FEATURES (Coming Soon)
# WEBHOOK_URL=
# CRM_INTEGRATION=
# EMAIL_SERVICE_API=
# ANALYTICS_TRACKING=